# Copy to .env to override defaults. Every value is optional.
KESTREL_INPUT_DIR=data/input
KESTREL_ARTIFACT_DIR=artifacts
KESTREL_PLUGINS_DIR=plugins
KESTREL_SKILLS_DIR=skills
# Leave empty to pick a sheet automatically (sheet named after the file role, else the first sheet).
KESTREL_EXCEL_SHEET=
# Seconds between input-folder scans. 0 disables the watcher.
KESTREL_WATCH_INTERVAL=5
# true = retrain automatically when new valid input files settle.
KESTREL_AUTO_TRAIN=false
# true = smaller hyper-parameter grid (faster, used by tests).
KESTREL_FAST=false
# Where render_docs writes MEMO.md and EVIDENCE.md.
KESTREL_OUTPUT_DIR=output
KESTREL_LOG_LEVEL=INFO
KESTREL_HOST=127.0.0.1
KESTREL_PORT=8000
